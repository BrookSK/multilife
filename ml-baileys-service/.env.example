# SÓ PARA INSTALAÇÃO EM VPS (pm2). Na hospedagem do sistema (painel Node.js do
# Plesk/cPanel) nada disto é necessário: o sistema PHP grava a configuração
# sozinho em runtime-config.php (veja CONFIGURAR_WHATSAPP_NA_HOSPEDAGEM.md).
# Copie para .env e preencha. Nunca suba o .env para o git.

# HTTP
HOST=0.0.0.0
PORT=8090
# Chave da API (header "apikey"). É o mesmo valor que vai em
# Configurações → WhatsApp Conexão → Token (API Key) no Multilife.
API_KEY=
# URL pública deste serviço (vai no campo server_url do webhook e no auto-ping)
PUBLIC_URL=http://177.104.185.7:8090
LOG_LEVEL=info

# Banco (MySQL 5.7+/8 ou MariaDB 10.3+). As tabelas baileys_* são criadas sozinhas.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ml_baileys
DB_PASSWORD=
DB_NAME=ml_baileys
# DB_SOCKET=/var/lib/mysql/mysql.sock

# Webhook usado quando a instância não tem um próprio. Ex.: https://<site>/chat_webhook.php
DEFAULT_WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRIES=5
WEBHOOK_CONCURRENCY=3
WEBHOOK_QUEUE_MAX=5000

# Dias que as mensagens ficam guardadas (download de mídia antiga e "Sincronizar").
# 0 = PARA SEMPRE (padrão): nada é apagado.
MESSAGE_RETENTION_DAYS=0
MAX_MEDIA_MB=64

# Monitor de conexão: sem eventos acima disso com o socket aberto = "silent"
SILENT_THRESHOLD_SEC=1800
WARMUP_SEC=300
STATUS_LOG_INTERVAL_MIN=5
# Registro do gráfico de conexão (não são mensagens). 0 = para sempre.
STATUS_LOG_RETENTION_DAYS=90

# Nome do aparelho em "Aparelhos conectados" no celular
BROWSER_NAME=Multilife
# QR Codes gerados sem leitura antes de desistir (cada um vale ~20 s)
QRCODE_LIMIT=6
# ffmpeg é opcional: o áudio gravado no navegador já é convertido sem ele
FFMPEG_PATH=ffmpeg
