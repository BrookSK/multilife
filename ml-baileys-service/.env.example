# Copie para .env e preencha. Nunca suba o .env para o git.

# HTTP
HOST=0.0.0.0
PORT=8090
# Chave da API (header "apikey"). Gere uma longa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# É o mesmo valor que vai em Configurações → WhatsApp Conexão → Token (API Key) no Multilife.
API_KEY=
# URL pública deste serviço (opcional; vai no campo server_url do webhook)
PUBLIC_URL=http://177.104.185.7:8090
LOG_LEVEL=info

# Banco (MySQL 5.7+/8 ou MariaDB 10.3+). Pode ser um banco só para o serviço.
# As tabelas baileys_* são criadas sozinhas no boot.
# max_allowed_packet >= 64M (a sessão de cada número é gravada num JSON único).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ml_baileys
DB_PASSWORD=
DB_NAME=ml_baileys

# Webhook usado quando a instância não tem um próprio (o Multilife configura o
# dele por /webhook/set ao conectar). Ex.: https://<site>/chat_webhook.php
DEFAULT_WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRIES=5
WEBHOOK_CONCURRENCY=3
WEBHOOK_QUEUE_MAX=5000

# Mensagens guardadas (findMessages, download de mídia e o "Sincronizar")
MESSAGE_RETENTION_DAYS=15
MAX_MEDIA_MB=64

# Monitor de conexão: sem eventos acima disso com o socket aberto = "silent"
SILENT_THRESHOLD_SEC=1800
WARMUP_SEC=300
STATUS_LOG_INTERVAL_MIN=5
STATUS_LOG_RETENTION_DAYS=30

# Nome do aparelho em "Aparelhos conectados" no celular
BROWSER_NAME=Multilife
# QR Codes gerados sem leitura antes de desistir (cada um vale ~20 s)
QRCODE_LIMIT=6
# ffmpeg converte áudio para nota de voz (ogg/opus). Sem ele o áudio vai como está.
FFMPEG_PATH=ffmpeg
