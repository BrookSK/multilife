# Limites de upload
php_value upload_max_filesize 50M
php_value post_max_size 55M
php_value max_execution_time 120
php_value max_input_time 120

# ============================================================================
# Rotas limpas (URLs sem ".php")
# Ex.: /monitoramento  ->  serve /monitoramento.php
# Só reescreve quando NÃO existe um arquivo/diretório com o caminho pedido,
# então arquivos .php diretos, imagens e assets continuam funcionando normalmente.
# ============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Alias amigável: /atualizar-cadastro -> complete_registration.php (link enviado ao profissional)
    RewriteRule ^atualizar-cadastro/?$ /complete_registration.php [L,QSA]

    # Se a URL pedida não é um arquivo nem um diretório existente,
    # e existe um .php com esse nome, serve o .php internamente (sem mudar a URL).
    # Isso permite acessar /monitoramento e o servidor entregar /monitoramento.php,
    # SEM redirecionar — então formulários POST (login, etc.) continuam funcionando.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^.]+)$ /$1.php [L,QSA]
</IfModule>
